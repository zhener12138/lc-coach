# ---- 构建产物 ----
target/

# ---- 运行数据（含力扣 session cookie，绝不能入库）----
# 注意 data/backup/ 里是数据库快照，同样含 cookie，所以整个 data/ 一并排除
data/
*.log

# ---- 运行时临时目录（tmpdir 不可写时 App 会降级到这里）----
.jtmp/

# ---- 模板编译校验的中间产物（1442 个 .class，可重新生成）----
.verify-out/
.schedtest/

# ---- 编辑器 / 系统 ----
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ---- 依赖 ----
node_modules/

# 提交信息草稿（用 git commit -F 读，不入库）
content-src/_commit-msg.txt

# 备用构建目录（target 被锁时用来打包，不该入库）
build2/
